# -----------------------------------------------------------------------------
# ATTENDANCE AI - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Copy this file to '.env' and fill in your actual connection strings.
# Do NOT commit your actual '.env' file to version control.

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=attendance_db

# Shift Threshold Defaults (Fallback if MongoDB global_config is unreachable)
# Format: HH:MM:SS
LOGIN_TIME=09:30:00
LOGOUT_TIME=16:30:00

# FAISS Vector Search Similarity Threshold
SIMILARITY_THRESHOLD=0.70

# Camera: webcam index (0, 1, ...) or an RTSP/HTTP stream URL
CAMERA_SOURCE=0

# Admin authentication — CHANGE THESE IN PRODUCTION
ADMIN_PIN=1234
# Long random string; generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random key is generated per start (admins are logged out on restart).
SECRET_KEY=
SESSION_MINUTES=5

# Comma-separated origins allowed to call the API cross-origin (dev Vite server).
# Not needed in production — the backend serves the built frontend on the same origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model / data paths (relative to the project root). The YOLO face detector is
# pretrained and auto-downloaded on first start; the FAISS index starts empty.
# YOLO_MODEL_PATH=yolov8n-face.pt
# FAISS_INDEX_PATH=student_index.faiss
# LABELS_PATH=labels.pkl
# DATASET_DIR=processed_dataset
# FRONTEND_DIST=frontend/dist
